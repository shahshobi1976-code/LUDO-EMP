# Server Configuration
PORT=3000
NODE_ENV=development
HOST=localhost

# Colyseus Configuration
COLYSEUS_DEBUG=false
COLYSEUS_PORT=3000
COLYSEUS_HOST=localhost

# Client Configuration
GAME_SERVER_URL=ws://localhost:3000
API_BASE_URL=http://localhost:3000

# Room Configuration
MAX_PLAYERS=5
MAX_ROOMS=100
ROOM_TIMEOUT=3600000
ENABLE_ROOM_CLEANUP=true

# Player Settings
PLAYER_TIMEOUT=300000
PLAYER_INACTIVITY_TIMEOUT=600000

# Game Settings
GAME_TIMEOUT=3600000
DICE_ROLL_DELAY=1000
GAME_START_DELAY=3000
TURN_TIMEOUT=120000

# Friend Features
ENABLE_FRIEND_ROOMS=true
ENABLE_PRIVATE_ROOMS=true
ENABLE_INVITE_SYSTEM=true
MAX_FRIENDS_PER_INVITE=10

# Authentication
ENABLE_AUTH=false
AUTH_TOKEN_EXPIRY=86400000
JWT_SECRET=your-secret-key-here

# Database (Optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ludo_emperor
DB_USER=postgres
DB_PASSWORD=password

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_FILE_LOGGING=false
LOG_FILE_PATH=./logs/

# Redis (Optional - for session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# CORS Settings
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Analytics (Optional)
ENABLE_ANALYTICS=false
ANALYTICS_KEY=your-key-here

# Environment
ENVIRONMENT=development
